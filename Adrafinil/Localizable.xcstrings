          }
        }
      }
    },
    "The update couldn't be installed. Try again, or get it from the releases page." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートをインストールできませんでした。もう一度試すか、リリースページから入手してください。"
