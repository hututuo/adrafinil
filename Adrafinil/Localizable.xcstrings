          }
        }
      }
    },
    "The low-battery cutout fired — acquires are paused until charging resumes or the lid opens." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー残量低下時の保護が作動しました。充電が再開するかふたを開くまで、新しいスリープ抑止の要求は保留されます。"
          }
