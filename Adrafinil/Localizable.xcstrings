        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现 Agent"
          }
        }
      }
    },
    "Force sleep when CPU temperature is too high" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 温度が高すぎるときは強制的にスリープ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 温度过高时强制睡眠"
