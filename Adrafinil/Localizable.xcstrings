{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ [Releases page.](https://github.com/kageroumado/adrafinil/releases)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@[リリースページを開く。](https://github.com/kageroumado/adrafinil/releases)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@[前往发布页面。](https://github.com/kageroumado/adrafinil/releases)"
          }
        }
      }
    },
    "%@ may not be tracked" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は追跡されていない可能性があります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可能未被跟踪"
          }
        }
      }
    },
    "%@'s Adrafinil hook isn't in the form Adrafinil expects — likely edited by hand or left over from an update — so it may not notice when %@ is working and keep your Mac awake. Reconnect restores it without touching your other %@ settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の Adrafinil フックが Adrafinil の想定する形式と異なります。手動で編集されたか、アップデート後に残ったものと思われます。そのため %2$@ の作業中であることを検知できず、Mac のスリープを抑止できない可能性があります。「再接続」を選ぶと、他の %3$@ の設定には触れずに修復します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的 Adrafinil 钩子与 Adrafinil 预期的格式不符——可能被手动编辑过，或是更新后遗留的——因此可能无法察觉 %2$@ 何时在工作并让你的 Mac 保持唤醒。重新连接会恢复它，不会改动你的其他 %3$@ 设置。"
          }
        }
      }
    },
    "%@'s settings file couldn't be read (it may contain comments or a syntax error). Adrafinil won't modify it in this state — fix the file, then try connecting again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の設定ファイルを読み込めませんでした（コメントや構文エラーが含まれている可能性があります）。この状態では Adrafinil はファイルを変更しません。ファイルを修正してから、もう一度接続してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@ 的设置文件（可能包含注释或语法错误）。在这种状态下 Adrafinil 不会修改它——请修复文件后再尝试连接。"
          }
        }
      }
    },
    "%@." : {
      "comment" : "Ends the agent tally as a sentence",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。"
          }
        }
      }
    },
    "%lld agents finished" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld agent finished"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld agents finished"
                }
              }
            }
