          }
        }
      }
    },
    "The thermal cutout fired — acquires are paused until the Mac cools down or the lid opens." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過熱保護が作動しました。Mac が冷えるかふたを開くまで、新しいスリープ抑止の要求は保留されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
